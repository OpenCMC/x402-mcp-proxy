# x402 Payment Keys (at least one required)
EVM_PRIVATE_KEY=0x_your_evm_private_key_here
SVM_PRIVATE_KEY=your_base58_encoded_solana_private_key_here

# Payment safety limits
# X402_MAX_PAYMENT=100000                   # Max amount per request in asset smallest unit (default: 100000 = 0.10 USDC)
# X402_MAX_SPEND_PER_SESSION=1000000        # Max total spend per session (default: 1000000 = 1.00 USDC)
# X402_ALLOWED_NETWORKS=eip155:8453,solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp
# X402_ALLOWED_ASSETS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913,EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# Remote MCPs — prefix,url pairs (alternative to x402-mcps.json config file)
# X402_REMOTE_MCPS=cmc,https://pro.coinmarketcap.com/x402/mcp

# Path to config file (default: x402-mcps.json in project root)
# X402_CONFIG=./x402-mcps.json
